# HikerAPI — Instagram data provider
# Registrati su https://hikerapi.com per ottenere la chiave
HIKERAPI_ACCESS_KEY=your_hikerapi_access_key_here
HIKERAPI_BASE_URL=https://api.hikerapi.com

# Supabase — Database
# Crea un progetto gratuito su https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Budget configuration (USD)
# Cap mensile oltre il quale le deep analysis vengono bloccate
NEXT_PUBLIC_MONTHLY_BUDGET_CAP=20

# Cron secret (richiesto da Vercel Cron)
# Genera una stringa casuale di almeno 32 caratteri
CRON_SECRET=your_random_secret_here

# Simple access protection (opzionale, per tool interno)
# Se valorizzata, la homepage chiederà questa password
APP_ACCESS_PASSWORD=
